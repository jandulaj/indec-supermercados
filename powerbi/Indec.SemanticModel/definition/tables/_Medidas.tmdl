table _Medidas
	lineageTag: 2f99bb3f-3f5c-420b-ba1d-940d185f1a71

	measure 'Acumulado año' =
			
			VAR ultima = CALCULATE ( MAX ( 'super fact_indices'[periodo] ), ALLSELECTED ( 'super dim_periodo' ) )
			RETURN
			    CALCULATE (
			        MAX ( 'super fact_indices'[var_acum] ),
			        ALLSELECTED ( 'super dim_periodo' ),
			        'super dim_periodo'[periodo] = ultima
			    ) / 100
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Q1 Evolución
		lineageTag: 912b7518-46ce-4256-a753-acc0ac53b5c3

	measure 'Distancia al Máximo' = DIVIDE ( [Indice Actual], [Indice Máximo] ) - 1
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Q1 Evolución
		lineageTag: 7baa348d-0749-4dcc-b361-cf79e8bd5988

	measure 'Indice Actual' =
			
			VAR UltimoPeriodo =
			    CALCULATE(
			        MAX('super fact_indices'[periodo]),
			        REMOVEFILTERS('super dim_periodo')
			    )
			RETURN
			    CALCULATE(
			        MAX('super fact_indices'[idx_desest]),
			        REMOVEFILTERS('super dim_periodo'),
			        'super fact_indices'[periodo] = UltimoPeriodo
			    )
		formatString: 0.0
		displayFolder: Q1 Evolución
		lineageTag: 85dc2f09-4950-47b9-9239-2360a3f52365

	measure 'Indice Máximo' = ```
			
			    CALCULATE(
			        MAX('super fact_indices'[idx_desest]),
			        ALL('super dim_periodo')
			    )
			```
		formatString: 0.0
		displayFolder: Q1 Evolución
		lineageTag: 6ed3126c-af10-4d3e-8d84-8ba21fc7664c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Marcas desest' =
			
			VAR v      = AVERAGE ( 'super fact_indices'[idx_desest] )
			VAR maxv   = CALCULATE ( MAX ( 'super fact_indices'[idx_desest] ), ALLSELECTED ( 'super dim_periodo' ) )
			VAR minv   = CALCULATE ( MIN ( 'super fact_indices'[idx_desest] ), ALLSELECTED ( 'super dim_periodo' ) )
			VAR ultima = CALCULATE ( MAX ( 'super fact_indices'[periodo] ), ALLSELECTED ( 'super dim_periodo' ) )
			VAR actual = MAX ( 'super fact_indices'[periodo] )
			RETURN
			    IF ( NOT ISBLANK ( v ) && ( v = maxv || v = minv || actual = ultima ), v )
		displayFolder: Q1 Evolución
		lineageTag: bce0e3e9-14ea-42fa-a68b-ca36dbddbc95

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure mayor_inflacion = ```
			
			VAR inflacion =
			    ADDCOLUMNS(
			        FILTER(
			            ALL('super dim_periodo'[anio]), ('super dim_periodo'[anio] > [primer_anio]) && ('super dim_periodo'[anio] <= [ultimo_anio])),
			        "@precio", [Precio],
			        "@precio_aa",
			            VAR _anio = 'super dim_periodo'[anio] - 1
			            RETURN
			                CALCULATE([Precio], 'super dim_periodo'[anio] = _anio))
			var mayor_inflacion = 
			    TOPN(1, ADDCOLUMNS(inflacion, "@inflacion", DIVIDE([@precio], [@precio_aa]) - 1), [@inflacion], DESC)
			    
			RETURN
			    CONCATENATEX(mayor_inflacion, 'super dim_periodo'[anio] & ": " & FORMAT ([@inflacion], "+0.0%;-0.0%"))
			
			```
		displayFolder: Q2 Precio vs volumen
		lineageTag: 33c53d8d-035c-46b3-9c48-df232c55e27b

	measure Nominal = AVERAGE('super fact_indices'[idx_corriente])
		formatString: 0.0
		displayFolder: Base
		lineageTag: 3828d508-a95b-4937-b3d2-1ed812aaf452

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure peor_anio = ```
			
			VAR volumenes =
			    ADDCOLUMNS (
			        FILTER(
						ALL ('super dim_periodo'[anio] ), ('super dim_periodo'[anio] > [primer_anio]) &&  ('super dim_periodo'[anio] <= [ultimo_anio])),	
			        	"@volumen", 
							[Volumen], 
						"@volumen_aa", 
							Var _anio = 'super dim_periodo'[anio]-1
							RETURN CALCULATE([Volumen], 'super dim_periodo'[anio] = _anio))
			VAR peor =
			    TOPN ( 1, ADDCOLUMNS ( volumenes, "@variacion", DIVIDE ( [@volumen], [@volumen_aa] ) - 1 ), [@variacion], ASC )
			RETURN
			    CONCATENATEX ( peor, 'super dim_periodo'[anio] & ": " & FORMAT ( [@variacion], "0.0%" ) )
			```
		displayFolder: Q1 Evolución
		lineageTag: 3ff7f8f1-a35b-48a7-b5b2-eb28aced1378

	measure Precio = AVERAGE('super fact_indices'[idx_precios_impl])
		formatString: 0.0
		displayFolder: Base
		lineageTag: d6487098-58ad-4b7e-b17a-b7dc188e0ae2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure primer_anio = CALCULATE(YEAR(MIN('super fact_indices'[periodo])), ALLSELECTED('super dim_periodo'))
		formatString: 0
		displayFolder: Auxiliares
		lineageTag: 3a4538b3-6deb-4344-ab88-493f037d4ccf

	measure 'Subtítulo evolución' =
			
			VAR maxv   = CALCULATE ( MAX ( 'super fact_indices'[idx_desest] ), ALLSELECTED ( 'super dim_periodo' ) )
			VAR ultima = CALCULATE ( MAX ( 'super fact_indices'[periodo] ), ALLSELECTED ( 'super dim_periodo' ) )
			VAR vult   = CALCULATE ( MAX ( 'super fact_indices'[idx_desest] ),
			                         ALLSELECTED ( 'super dim_periodo' ), 'super dim_periodo'[periodo] = ultima )
			RETURN
			    "Último dato (" & FORMAT ( ultima, "mmm yyyy" ) & "): "
			        & FORMAT ( DIVIDE ( vult, maxv ) - 1, "0 %" ) & " respecto del máximo del período"
		displayFolder: Q1 Evolución
		lineageTag: 305a318a-2b0e-4449-b525-006fdf91be8e

	measure ultimo_anio = CALCULATE(YEAR(MAX('super fact_indices'[periodo])), ALLSELECTED('super dim_periodo'), MONTH('super fact_indices'[periodo]) = 12)
		formatString: 0
		displayFolder: Auxiliares
		lineageTag: 8957c20e-9045-46e1-99f3-b543aeedfe02

	measure 'var volumen 1er-último año completo' =
			
			VAR _primer_anio = [primer_anio]
			VAR _ultimo_anio = [ultimo_anio]
			
			VAR primer_indice = CALCULATE([Volumen], 'super dim_periodo'[anio]=_primer_anio, REMOVEFILTERS('super dim_periodo'))
			VAR ultimo_indice = CALCULATE([Volumen], 'super dim_periodo'[anio]=_ultimo_anio, REMOVEFILTERS('super dim_periodo'))
			RETURN
			    DIVIDE(ultimo_indice, primer_indice) -1
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Q2 Precio vs volumen
		lineageTag: f182f49e-8289-4c6f-b359-8beea85c1138

	measure 'Var nominal 1er-último año completo' =
			
			VAR meses_por_anio =
			    ADDCOLUMNS (
			        ALL ( 'super dim_periodo'[anio] ),                      -- una fila por año, sin filtros del visual
			        "@meses",
			            VAR a = 'super dim_periodo'[anio]                   -- el año de la fila actual
			            RETURN
			                COUNTROWS (
			                    FILTER (
			                        ALL ( 'super fact_indices'[periodo] ),  -- todos los meses con dato
			                        YEAR ( 'super fact_indices'[periodo] ) = a
			                    )
			                )
			    )
			VAR _primer_anio = [primer_anio]
			VAR _ultimo_anio = [ultimo_anio]
			
			VAR primer_indice = CALCULATE([Nominal], 'super dim_periodo'[anio]=_primer_anio, REMOVEFILTERS('super dim_periodo'))
			VAR ultimo_indice = CALCULATE([Nominal], 'super dim_periodo'[anio]=_ultimo_anio, REMOVEFILTERS('super dim_periodo'))
			RETURN
			    DIVIDE(ultimo_indice, primer_indice)
		formatString: """×""0.0"
		displayFolder: Q2 Precio vs volumen
		lineageTag: 5ec5a944-c65c-4ab0-9525-eef90a02dfd5

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Var precio 1er-último año completo' =
			
			VAR ultimo_periodo = CALCULATE(MAX('super fact_indices'[periodo]), REMOVEFILTERS('super dim_periodo'))
			VAR _primer_anio = [primer_anio]
			VAR _ultimo_anio = [ultimo_anio]
			VAR primer_indice = CALCULATE([Precio], 'super dim_periodo'[anio]=_primer_anio, REMOVEFILTERS('super dim_periodo'))
			VAR ultimo_indice = CALCULATE([Precio], 'super dim_periodo'[anio]=_ultimo_anio, REMOVEFILTERS('super dim_periodo'))
			RETURN
			    DIVIDE(ultimo_indice, primer_indice)
		formatString: """×""0.0"
		displayFolder: Q2 Precio vs volumen
		lineageTag: 4d6acfc1-21b5-4b2a-878d-31b080950a59

		annotation PBI_FormatHint = {"isCustom":true}

	measure var_precio = ```
			
			VAR _anio = MAX('super dim_periodo'[anio])
			VAR precio_aa = CALCULATE(
			    [Precio], 
			    'super dim_periodo'[anio]=_anio-1)
			RETURN
			    IF (_anio > [primer_anio] && _anio <= [ultimo_anio], DIVIDE([Precio],precio_aa)-1, BLANK())
			```
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Q2 Precio vs volumen
		lineageTag: 4696bf06-7da2-487e-a164-d225bea5865c

	measure var_volumen = ```
			
			VAR _anio = MAX('super dim_periodo'[anio])
			VAR volumen_aa = CALCULATE(
			    [Volumen], 
			    'super dim_periodo'[anio]=_anio-1)
			RETURN
			    IF (_anio > [primer_anio] && _anio <= [ultimo_anio], DIVIDE([Volumen],volumen_aa)-1, BLANK())
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Q2 Precio vs volumen
		lineageTag: 52ba64f9-5fd1-4314-977a-1595dfa06756

	measure Volumen = AVERAGE('super fact_indices'[idx_original])
		formatString: 0.0
		displayFolder: Base
		lineageTag: 46eb8ce0-5f2a-481b-9ee8-43d1a4ff7ee8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas canal' = SUM ( 'super fact_ventas_canal'[ventas_miles] )
		displayFolder: Base
		lineageTag: 2f2abba9-602d-46d0-8b09-2405bdff995b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rubro que más ganó' =
			
			VAR _rubros =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'super dim_categoria'[nombre_corto] ),
			            'super dim_categoria'[es_total] = FALSE ()
			        ),
			        "@cambio", [Cambio pp]
			    )
			VAR _primero = TOPN ( 1, _rubros, [@cambio], DESC )
			RETURN
			    CONCATENATEX (
			        _primero,
			        'super dim_categoria'[nombre_corto] & "  " & FORMAT ( [@cambio], "+0.0 ""pp"";-0.0 ""pp""" ),
			        ", "
			    )
		displayFolder: Q3 Canasta
		lineageTag: 9e2f1f4a-2ed1-4327-a241-9fb28bfe6cb1

	measure 'Rubro que más perdió' =
			
			VAR _rubros =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( 'super dim_categoria'[nombre_corto] ),
			            'super dim_categoria'[es_total] = FALSE ()
			        ),
			        "@cambio", [Cambio pp]
			    )
			VAR _ultimo = TOPN ( 1, _rubros, [@cambio], ASC )
			RETURN
			    CONCATENATEX (
			        _ultimo,
			        'super dim_categoria'[nombre_corto] & "  " & FORMAT ( [@cambio], "+0.0 ""pp"";-0.0 ""pp""" ),
			        ", "
			    )
		displayFolder: Q3 Canasta
		lineageTag: bbd461a8-595d-46d8-adfe-ba6e9c427448

	measure 'Var i.a. real jurisdicción' =
			
			VAR actual = CALCULATE ( [Ventas reales por jurisdicción], 'super dim_periodo'[con_datos] = TRUE () )
			VAR fechas = CALCULATETABLE ( VALUES ( 'super dim_periodo'[periodo] ), 'super dim_periodo'[con_datos] = TRUE () )
			VAR anterior = CALCULATE ( [Ventas reales por jurisdicción], SAMEPERIODLASTYEAR ( fechas ) )
			RETURN DIVIDE ( actual, anterior ) - 1
		displayFolder: Q6 Provincias
		lineageTag: c8f9dc97-3aad-4cb7-b2f0-80f9d4b48e42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas por categoría' =
			
			CALCULATE (
			    SUM ( 'super fact_ventas_categoria'[ventas_miles] ),
			    'super dim_jurisdiccion'[es_total] = TRUE (),    -- total país: dato completo, sin "s"
			    'super dim_categoria'[es_total] = FALSE ()
			)
		displayFolder: Base
		lineageTag: b28dc00c-271d-409c-bc13-bca24532360d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas por jurisdicción' =
			
			CALCULATE (
			    SUM ( 'super fact_ventas_categoria'[ventas_miles] ),
			    'super dim_jurisdiccion'[es_total] = FALSE (),
			    'super dim_categoria'[es_total] = TRUE ()        -- total de la provincia: dato completo
			)
		displayFolder: Base
		lineageTag: 0c1dd16b-1268-409a-ba43-234a34329392

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas reales por categoría' =
			
			SUMX (
			    VALUES ( 'super dim_periodo'[inicio_mes] ),
			    DIVIDE (
			        [Ventas por categoría],
			        CALCULATE ( MAX ( 'super fact_indices'[idx_precios_impl] ) ) / 100
			    )
			)
		displayFolder: Q3 Canasta
		lineageTag: 0d724d20-bb37-4a41-9f9c-37efb6453530

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas reales por jurisdicción' =
			
			SUMX (
			    VALUES ( 'super dim_periodo'[inicio_mes] ),
			    DIVIDE (
			        [Ventas por jurisdicción],
			        CALCULATE ( MAX ( 'super fact_indices'[idx_precios_impl] ) ) / 100
			    )
			)
		displayFolder: Q6 Provincias
		lineageTag: 3826a803-f6a6-4070-a2e5-4683669f598e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cambio pp' = ```
			
			   VAR _anioIni = MIN ( 'super dim_periodo'[anio] )
			   VAR _anioFin = MIN ( MAX ( 'super dim_periodo'[anio] ), 2025 )   -- 2026 está incompleto
			   VAR _ini = CALCULATE ( [% tipo categoría], 'super dim_periodo'[anio] = _anioIni )
			   VAR _fin = CALCULATE ( [% tipo categoría], 'super dim_periodo'[anio] = _anioFin )
			   RETURN ROUND(( _fin - _ini ) * 100, 1)
			```
		formatString: +0.0 "pp";-0.0 "pp"
		displayFolder: Q3 Canasta
		lineageTag: 49ae3236-382c-4bc6-b8b4-f888ebb5661f

		annotation PBI_FormatHint = {"isCustom":true}

	measure '% tipo categoría' =
			
			DIVIDE (
			    [Ventas por categoría],
			    CALCULATE ( [Ventas por categoría], REMOVEFILTERS ( 'super dim_categoria' ) )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Q3 Canasta
		lineageTag: 167446b7-57c4-406a-a6d9-9e0062bc7559

	measure '% efectivo último año' =
			
			VAR anioUlt = YEAR ( CALCULATE ( MAX ( 'super fact_ventas_medio_pago'[periodo] ), ALLSELECTED ( 'super dim_periodo' ) ) )
			RETURN
			    CALCULATE (
			        [% medio de pago],
			        'super fact_ventas_medio_pago'[medio_pago] = "efectivo",
			        ALLSELECTED ( 'super dim_periodo' ),
			        'super dim_periodo'[anio] = anioUlt
			    )
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Q4 Medios de pago
		lineageTag: a9a56706-c41b-465e-8f70-f625aaf5ce34

	measure '% medio de pago' =
			
			DIVIDE (
			    [Ventas medio de pago],
			    CALCULATE (
			        [Ventas medio de pago],
			        REMOVEFILTERS (
			            'super fact_ventas_medio_pago'[medio_pago],
			            'super fact_ventas_medio_pago'[medio_pago_desc],
			            'super fact_ventas_medio_pago'[orden_medio]
			        )
			    )
			)
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Q4 Medios de pago
		lineageTag: 72b81548-1de3-4778-921f-55f00a4e92f6

	measure 'Ventas medio de pago' = ```
			SUM ( 'super fact_ventas_medio_pago'[ventas_miles] )
			
			```
		displayFolder: Base
		lineageTag: 97023541-40c3-4f45-941b-a7faac42ef53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

