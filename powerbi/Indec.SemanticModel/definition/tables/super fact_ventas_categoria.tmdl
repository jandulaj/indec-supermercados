		formatString: 0
		lineageTag: 27a4b8ea-338b-47c6-8bda-3a45206c5d5c
		summarizeBy: none
		sourceColumn: categoria_id

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column ventas_miles
		dataType: double
		lineageTag: ad6f43c6-f95b-4f76-8cf3-492d7f12ec67
		summarizeBy: sum
		sourceColumn: ventas_miles

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column es_confidencial
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 881215cd-9fe6-4d05-9d9e-b73cea6a4c01
